# Optional Convex deployment URL. Leave blank to use localStorage-only mode.
# Set this to your dev/prod Convex URL after running `pnpm dlx convex dev`.
VITE_CONVEX_URL=

# Optional Clerk publishable key. When set, the UI gates behind sign-in
# and every Convex request carries the Clerk JWT. Pair this with the
# CLERK_ISSUER_URL env var on your Convex deployment
# (`pnpm dlx convex env set CLERK_ISSUER_URL https://your-app.clerk.accounts.dev`).
VITE_CLERK_PUBLISHABLE_KEY=
